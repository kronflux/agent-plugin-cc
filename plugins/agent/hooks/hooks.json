{
  "description": "Session start and end, the optional stop-time review gate, and the council seat's reply.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--disable-warning=ExperimentalWarning",
              "${CLAUDE_PLUGIN_ROOT}/scripts/session-lifecycle-hook.mjs",
              "SessionStart"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--disable-warning=ExperimentalWarning",
              "${CLAUDE_PLUGIN_ROOT}/scripts/session-lifecycle-hook.mjs",
              "SessionEnd"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--disable-warning=ExperimentalWarning",
              "${CLAUDE_PLUGIN_ROOT}/scripts/stop-review-gate-hook.mjs"
            ],
            "timeout": 900
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--disable-warning=ExperimentalWarning",
              "${CLAUDE_PLUGIN_ROOT}/scripts/council-seat-hook.mjs"
            ],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
