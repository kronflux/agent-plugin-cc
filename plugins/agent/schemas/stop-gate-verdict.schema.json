  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "reason"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["allow", "block"]
    },
    "reason": {
      "type": "string"
    }
  }
}
