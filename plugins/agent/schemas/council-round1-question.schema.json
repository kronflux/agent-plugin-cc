{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-plugin:schema:council-round1-question:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "answer",
    "stance",
    "confidence",
    "dealbreaker",
    "findings",
    "assumptions",
    "wouldChangeMind"
  ],
  "properties": {
    "schema": {
      "type": "integer",
      "const": 1
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "stance": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "dealbreaker": {
      "type": [
        "string",
        "null"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "claim",
          "path",
          "line",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^f[1-9][0-9]{0,2}$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "P1",
              "P2",
              "P3"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "wouldChangeMind": {
      "type": "string"
    }
  }
}
