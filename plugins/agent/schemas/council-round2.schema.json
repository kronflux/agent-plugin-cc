{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-plugin:schema:council-round2:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "stance",
    "responses",
    "added"
  ],
  "properties": {
    "schema": {
      "type": "integer",
      "const": 1
    },
    "stance": {
      "type": [
        "string",
        "null"
      ]
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding",
          "response",
          "disputes",
          "sameAs",
          "reason",
          "evidence"
        ],
        "properties": {
          "finding": {
            "type": "string",
            "minLength": 1
          },
          "response": {
            "type": "string",
            "enum": [
              "validate",
              "challenge",
              "skip"
            ]
          },
          "disputes": {
            "type": [
              "string",
              "null"
            ]
          },
          "sameAs": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "added": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "claim",
          "path",
          "line",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^f[1-9][0-9]{0,2}$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "P1",
              "P2",
              "P3"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
